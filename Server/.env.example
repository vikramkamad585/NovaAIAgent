# Server environment variables. Copy to `.env` and fill in real values.
PORT=8000
# The frontend origin allowed by CORS + used for Stripe redirect URLs.
# Dev: http://localhost:5173  |  Production: your deployed client URL.
CLIENT_URL=http://localhost:5173
MONGODB_URL=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
STRIPE_SECRET_KEY=your_stripe_secret_key
